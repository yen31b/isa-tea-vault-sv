// Programa de verificacion integral simplificado
// 0: MOV r0, #0xA5A5
6000A5A5
// 1: SLLI r0, r0, #16 (r0 = 0xA5A50000)
// op=10110(22), rd=0, rs1=0, imm=16
// 10110 0000 0000 0000000000000010000
// 31-24: 10110000 = B0
// 23-16: 00000000 = 00
// 15-8:  00000000 = 00
// 7-0:   00010000 = 10
B0000010
// 2: MOV r1, #0xA5A5
6080A5A5
// 3: OR r0, r0, r1 (r0 = 0xA5A5A5A5)
30008000
// 4: NOP
F8000000
// 5: VAUTH r0
88000000
// 6: NOP
F8000000
// 7: MOV r1, #0x1234
60801234
// 8: VSTR slot=0, word=0, r1
70020000
// 9: VSTR slot=0, word=1, r1
70220000
// 10: VSTR slot=0, word=2, r1
70420000
// 11: VSTR slot=0, word=3, r1
70620000
// 12: NOP
F8000000
// 13: VLD slot=0, word=0
78000000
// 14: VLD slot=0, word=1
78200000
// 15: VLD slot=0, word=2
78400000
// 16: VLD slot=0, word=3
78600000
// 17: NOP
F8000000
// 18: MOV r2, #0
61000000
// 19: LD r3, 0(r2) (RAM[0])
01900000
// 20: MOV r2, #4
61000004
// 21: LD r5, 0(r2) (RAM[4])
02900000
// 22: NOP
F8000000
